{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hackelia-micrantha/phyllotaxis-community/blob/main/contracts/public-interface.schema.json",
  "title": "Phyllotaxis public interface contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "maturity",
    "contracts",
    "packageExports",
    "runtimeExports",
    "typeExports",
    "css",
    "cli",
    "chromaInspection"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "package": {
      "const": "@hackelia-micrantha/phyllotaxis"
    },
    "maturity": {
      "enum": [
        "experimental",
        "incubating",
        "active",
        "stable"
      ]
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "venation",
        "chroma"
      ],
      "properties": {
        "venation": {
          "type": "integer",
          "minimum": 1
        },
        "chroma": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "packageExports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtimeExports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
      }
    },
    "typeExports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
      }
    },
    "css": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredPublicCustomProperties",
        "profileAttribute",
        "profiles",
        "schemeAttribute",
        "schemes"
      ],
      "properties": {
        "requiredPublicCustomProperties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^--phyllotaxis-[a-z0-9-]+$"
          }
        },
        "profileAttribute": {
          "const": "data-phyllotaxis-profile"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "schemeAttribute": {
          "const": "data-phyllotaxis-scheme"
        },
        "schemes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "commands",
        "formatFlag",
        "formats",
        "globalOptions",
        "commonCommandOptions",
        "exitStatuses"
      ],
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "experimental",
            "supported"
          ]
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "formatFlag": {
          "const": "--format"
        },
        "formats": {
          "type": "array",
          "contains": {
            "const": "text"
          },
          "items": {
            "enum": [
              "text",
              "json",
              "jsonl"
            ]
          },
          "uniqueItems": true
        },
        "globalOptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^--[a-z0-9-]+$"
          }
        },
        "commonCommandOptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^--[a-z0-9-]+$"
          }
        },
        "exitStatuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "chromaInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageExport",
        "schemaVersion",
        "contractVersion",
        "defaultProfile"
      ],
      "properties": {
        "packageExport": {
          "const": "./chroma-contract.json"
        },
        "schemaVersion": {
          "const": 1
        },
        "contractVersion": {
          "const": 1
        },
        "defaultProfile": {
          "const": "utility"
        }
      }
    }
  }
}
